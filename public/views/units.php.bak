<?php

use App\Models\Unit;

$units = Unit::all();

$pageTitle = 'Units';

ob_start();
?>

<h2 class="mb-4">
    Storage Units
</h2>

<?php if (isset($_GET['saved'])): ?>

<div
    id="saveAlert"
    class="alert alert-success alert-dismissible fade show auto-alert"
    role="alert">

    <strong>Success!</strong>
    Unit updated successfully.

    <button
        type="button"
        class="btn-close"
        data-bs-dismiss="alert">
    </button>

</div>

<?php endif; ?>

<table
    id="unitsTable"
    class="table table-striped table-hover">

    <thead>

        <tr>

            <th>Unit</th>

            <th>Status</th>

            <th>Occupier</th>

            <th>Arrears</th>

            <th>Actions</th>

        </tr>

    </thead>

    <tbody>

        <?php foreach ($units as $unit): ?>

            <tr>

                <td>

                    <?= htmlspecialchars(
                        $unit['unit_code']
                    ) ?>

                </td>

                <td>

<?php

$badge = 'secondary';

if ($unit['occupancy_status'] === 'Occupied')
{
    $badge = 'success';
}
elseif ($unit['occupancy_status'] === 'Vacant')
{
    $badge = 'warning';
}
elseif ($unit['occupancy_status'] === 'Reserved')
{
    $badge = 'primary';
}

?>


<span class="badge bg-<?= $badge ?>">

    <?= htmlspecialchars(
        $unit['occupancy_status']
    ) ?>

</span>

</td>

                </td>

                <td>

                    <?= htmlspecialchars(
                        $unit['occupier_name']
                    ) ?>

                </td>

<td>

<?php

$arrearsBadge = 'success';

if ($unit['arrears_status'] === 'Outstanding')
{
    $arrearsBadge = 'warning';
}
elseif ($unit['arrears_status'] === 'Overdue')
{
    $arrearsBadge = 'danger';
}

?>

<span class="badge bg-<?= $arrearsBadge ?>">

    <?= htmlspecialchars(
        $unit['arrears_status']
    ) ?>

</span>

</td>

                <td>

                    <a
                        href="/unit/edit?id=<?= $unit['id'] ?>"
                        class="btn btn-primary btn-sm">

                        Edit

                    </a>

                </td>

            </tr>

        <?php endforeach; ?>

    </tbody>

</table>

<script>

$(document).ready(function() {

    $('#unitsTable').DataTable();

});

</script>
<script>

document.addEventListener('DOMContentLoaded', function () {

    const saveAlert = document.getElementById('saveAlert');

    if (saveAlert) {

        setTimeout(function () {

            saveAlert.classList.remove('show');

            setTimeout(function () {
                saveAlert.remove();
            }, 500);

        }, 2500);

    }

});

</script>


<?php

$content = ob_get_clean();

include __DIR__ .
    '/layouts/main.php';

